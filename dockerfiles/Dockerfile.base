# PTB base image for our fork.
#
# Mirrors PostTrainBench's harbor_adapter/template/environment/Dockerfile
# (the curated stack: vllm 0.11.0, claude-code, codex, gemini-cli, full ML
# package set, inspect_evals from GitHub) WITHOUT the per-task COPY layer.
# Per-task images derive from this via `FROM ghcr.io/jackpayne123/ptb-base:24`.
#
# Pinned versions (vs PTB's template):
#   vllm==0.20.2              — needed for Qwen3.5 (`qwen3_5` arch). Bumped from
#                                0.11.0 on 2026-05-12. Forces torch==2.11.0
#                                (uninstall-cycle on base image's torch 2.4.0).
#   transformers>=4.56,<5.0   — vllm 0.20.2's floor + ceiling (it excludes 5.0-5.5).
#                                Qwen3-1.7B (backward compat) + Qwen3.5-9B both supported.
#
# Build via GitHub Actions (preferred — native amd64, ~10 min):
#   gh workflow run build-ptb-base.yml -f tag=N -R JackPayne123/PostTrainBench
#
# Build locally (linux/amd64 from M-series Mac — QEMU, ~30 min):
#   docker buildx build --platform linux/amd64 \
#     -f dockerfiles/Dockerfile.base \
#     -t ghcr.io/jackpayne123/ptb-base:N \
#     --push .
# Derive from RunPod's pytorch image — they ship a startup script that handles
# the $PUBLIC_KEY env var (writes authorized_keys, starts sshd) so the container
# stays alive and accepts SSH. nvcr.io/nvidia/cuda is bare and exits immediately
# (verified 2026-05-07: ptb-base:1 with bare cuda → container exited
# instantly).
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:$PATH"
ENV NO_PROXY="localhost,127.0.0.1"
ENV no_proxy="localhost,127.0.0.1"

# System deps (rsync needed for our upload_dir/download_dir; git already in base)
# psmisc provides fuser/killall (port-based + name-based process kill).
# lsof provides another way to find PIDs holding files/ports.
# procps ensures pkill/pgrep/ps are present.
# iproute2 provides ss (port-based PID lookup) — usually present, listed for safety.
RUN apt-get update && apt-get install -y \
    rsync \
    ca-certificates \
    psmisc \
    lsof \
    procps \
    iproute2 \
    tmux \
    jq \
    curl \
    unzip \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# rclone — fetch current stable directly from rclone's CDN. Ubuntu 22.04
# apt ships v1.58.1 (2022) which doesn't even search /etc/rclone.conf.
# The install.sh path (curl rclone.org/install.sh | bash) failed build
# :11 with curl exit 92 (HTTP/2 stream not closed cleanly) — rclone.org
# fronts on a flaky HTTP/2 endpoint. downloads.rclone.org is HTTP/1.1
# and serves binaries directly. --retry buys us against transient
# CDN blips during CI.
RUN curl --http1.1 -fsSL --retry 5 --retry-delay 3 \
        https://downloads.rclone.org/rclone-current-linux-amd64.zip \
        -o /tmp/rclone.zip && \
    unzip -q /tmp/rclone.zip -d /tmp/ && \
    install -m 0755 /tmp/rclone-*-linux-amd64/rclone /usr/bin/rclone && \
    rm -rf /tmp/rclone* && \
    rclone version

# Node.js 22 + npm (for claude-code, codex, gemini-cli)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

# Note: PTB's original template uses `uv pip install --system`, but uv's resolver
# fails on vllm 0.11.0's xformers dep when run under QEMU emulation (arm64→amd64
# build on Apple Silicon). Plain pip handles it identically. Verified on a real
# RunPod x86_64 host 2026-05-07.

# vLLM 0.20.2 — bumped 2026-05-12 to support Qwen3.5 (`qwen3_5` arch landed
# in vllm 0.17.0 / 2026-03-07; 0.20.2 is current latest). Also pulls torch
# 2.11.0 which auto-upgrades the base image's 2.4.0 (~5 min of uninstall
# cycle during build, normal). Transformers pin below is keyed to this:
# vllm 0.20.2 requires transformers >=4.56.0, !=5.0.*..5.5.0 — keep below
# in sync with `pip show vllm; pip show transformers` after each bump.
RUN pip install --no-cache-dir vllm==0.20.2

# Coding agent CLIs
RUN npm install -g \
    @anthropic-ai/claude-code \
    @openai/codex \
    @google/gemini-cli

RUN pip install --no-cache-dir ninja packaging

# ML stack split in two to keep pip's resolver search space small.
# Use --use-deprecated=legacy-resolver throughout: pip's strict resolver
# backtracks aggressively on matplotlib/inspect-ai/etc and never converges
# under QEMU emulation in reasonable time. Legacy resolver matches first-fit
# (this is what uv/PTB-canonical install does on real x86_64 pods).
#
# Step A — training stack (HF ecosystem)
# transformers>=4.56,<5.0 — vllm 0.20.2 floor is 4.56; <5.0 still holds because
# vllm 0.20.2 explicitly excludes transformers 5.0-5.5. Re-check after each
# vllm bump. Qwen3.5 needs >=4.55 (the model card lists 4.55+). Qwen3-1.7B
# (still supported for backward compat) loads fine on 4.56+.
RUN pip install --no-cache-dir --use-deprecated=legacy-resolver \
    "transformers>=4.56,<5.0" \
    accelerate \
    datasets \
    evaluate \
    tokenizers \
    trl \
    peft

# Step B — eval / utility stack.
# huggingface-hub PINNED <1.0: inspect_evals depends on hf_hub 1.x but
# transformers 4.57.6 requires hf_hub<1.0,>=0.34.0. ptb-base:2 build let
# the conflict through (legacy-resolver warns, doesn't fail) and vllm
# crashed at runtime in import path. Pin keeps transformers callable.
RUN pip install --no-cache-dir --use-deprecated=legacy-resolver \
    "huggingface-hub>=0.34.0,<1.0" \
    anthropic \
    backoff \
    boto3 \
    bitsandbytes \
    hf_xet \
    hydra-core \
    "omegaconf>=2.4.0.dev2" \
    loguru \
    gdown \
    jsonlines \
    lm-eval \
    openai \
    pandas \
    scikit-learn \
    shortuuid \
    tiktoken \
    toml \
    "inspect-ai>=0.3.200" \
    "matplotlib>=3.7" \
    certifi

# inspect_evals (GitHub HEAD; matches PTB's pattern).
# --no-deps: prevents inspect_evals from upgrading huggingface_hub to 1.x
# (transformers 4.57 needs <1.0). Its actual transitive deps (backoff, hf_xet,
# toml) are installed explicitly in step B above. Verified end-to-end on debug
# pod 2026-05-07: vllm serves + responds to /v1/completions cleanly.
RUN mkdir -p /opt && \
    cd /opt && \
    git clone --depth=1 https://github.com/UKGovernmentBEIS/inspect_evals.git && \
    cd /opt/inspect_evals && \
    pip install --no-cache-dir --no-deps .

# Workspace dir for per-task COPY in derived images
RUN mkdir -p /home/agent/workspace
WORKDIR /home/agent/workspace

# ─── Self-driving pod harness (image-baked) ────────────────────────────────
#
# /opt/ptb/   = repo subset the PIPELINE (root) needs at runtime. Contains
#               eval task prompts (src/evals/tasks/{capability,safety,character}/)
#               and pipeline source.
#               chmod 700, root-only — the agent (uid 1000) cannot read it.
# /opt/pipeline-bin/score_runner.sh = root-owned wrapper invoked by the
#               agent's score.sh via sudo. Reads prompts from /opt/ptb,
#               queries the agent's local vllm, returns just the metrics
#               dict. Agent never sees prompts content.
# /opt/startup_hook.sh = invoked by the pod's container entrypoint after SSH
#                        comes up; polls /workspace/runs/$RUN_ID/START and
#                        execs run_experiment.py inside tmux session "run".
# ~/.config/rclone/rclone.conf = OAuth-based remote named "drive" targeting
#                        the experiments folder. Baked at build time from
#                        the RCLONE_CONF GitHub secret via BuildKit
#                        --mount=type=secret. SA-based auth was abandoned
#                        because service accounts have 0 Drive storage
#                        quota on personal Drives (storageQuotaExceeded
#                        on upload).
#
# Agent isolation (post 2026-05-10):
#   The agent ran as root pre-:11 and could `cat /opt/ptb/src/evals/tasks/safety/
#   <bench>/prompts.jsonl` directly to extract the test set. Caught on a
#   sycophancy_slava run. Now:
#     - `agent` user (uid 1000) created; pipeline (root) launches
#       solve.sh via `sudo -u agent`.
#     - /opt/ptb chmod 700, root-only.
#     - score.sh thin sudo-wrapper invokes /opt/pipeline-bin/score_runner.sh
#       which runs as root, reads prompts from /opt/ptb, returns metrics.
#
# To rebuild for a new src/ snapshot: bump tag, rerun
# `gh workflow run build-ptb-base.yml -f tag=N`.
#
# COPY of the repo only includes paths the pipeline needs at runtime.
# .dockerignore keeps jobs/runs/ etc. out.
COPY pod/                /opt/ptb/pod/
COPY src/runpod_backend/ /opt/ptb/src/runpod_backend/
COPY src/harbor_adapter/ /opt/ptb/src/harbor_adapter/
COPY src/evals/          /opt/ptb/src/evals/
COPY agents/             /opt/ptb/agents/
COPY pyproject.toml      /opt/ptb/pyproject.toml
# Empty src/__init__.py + src/evals/__init__.py would help `import
# src.evals.registry` resolve under PYTHONPATH=/opt/ptb. Pipeline
# imports as `from src.evals.registry import ...` to mirror laptop-side.
COPY src/__init__.py     /opt/ptb/src/__init__.py
COPY src/evals/__init__.py /opt/ptb/src/evals/__init__.py
RUN chmod 700 /opt/ptb && chown -R root:root /opt/ptb

COPY pod/startup_hook.sh /opt/startup_hook.sh
RUN chmod +x /opt/startup_hook.sh

# Pipeline-side score runner. Agent's score.sh sudo-invokes this so the
# agent can query the eval signal without ever reading prompts.jsonl
# directly. NOPASSWD entry below scopes sudo to this one binary.
COPY pod/score_runner.sh /opt/pipeline-bin/score_runner.sh
COPY pod/score_capability_runner.sh /opt/pipeline-bin/score_capability_runner.sh
COPY pod/time_remaining.sh /opt/pipeline-bin/time-remaining
RUN chown root:root /opt/pipeline-bin/score_runner.sh /opt/pipeline-bin/score_capability_runner.sh /opt/pipeline-bin/time-remaining && \
    chmod 0755 /opt/pipeline-bin/score_runner.sh /opt/pipeline-bin/score_capability_runner.sh /opt/pipeline-bin/time-remaining

# Create the non-root agent user. uid 1000 is conventional and free
# on the runpod/pytorch base. /home/agent/workspace is the per-task
# working directory; stage_agent_workspace populates it at runtime.
# /workspace is the persistent volume mount; mode 1777 lets both root
# (pipeline) and agent (uid 1000) read/write under it like /tmp.
RUN useradd -m -u 1000 -s /bin/bash agent && \
    chown -R agent:agent /home/agent && \
    mkdir -p /workspace && chmod 1777 /workspace

# NOPASSWD sudo, scoped to the pipeline-bin binaries. Agent cannot sudo
# anything else. Two whitelisted commands:
#   score_runner.sh — queries the held eval (single-bench accuracy /
#       composite objective, depending on score.sh contract).
#   time-remaining — reads /etc/ptb_run/deadline (chmod 600 root) and
#       prints integer seconds remaining in the budget.
RUN printf 'agent ALL=(root) NOPASSWD: /opt/pipeline-bin/score_runner.sh\nagent ALL=(root) NOPASSWD: /opt/pipeline-bin/score_capability_runner.sh\nagent ALL=(root) NOPASSWD: /opt/pipeline-bin/time-remaining\n' \
        > /etc/sudoers.d/agent-score && \
    chmod 0440 /etc/sudoers.d/agent-score && \
    visudo -c -f /etc/sudoers.d/agent-score

# OAuth-based rclone config for Drive uploads.
# Full rclone.conf (with refresh_token + root_folder_id) is mounted as a
# BuildKit secret named `rclone_conf` and written to rclone's default
# search path (/root/.config/rclone/rclone.conf). Tried /etc/rclone.conf
# first but rclone v1.58.1 (the version in our base image) does NOT
# search /etc — verified 2026-05-10 with diag_drive on :10. Diag tail:
#   Config file "/root/.config/rclone/rclone.conf" not found - using defaults
#   Failed to create file system for "drive:": didn't find section in config file
# Mount locally with:
#   docker buildx build --secret id=rclone_conf,src=$HOME/.config/ptb/rclone.conf ...
# In CI, the workflow passes secrets.RCLONE_CONF via build-push-action's
# `secret-files:` input. See dockerfiles/rclone.conf for expected structure.
RUN --mount=type=secret,id=rclone_conf,target=/tmp/rclone.conf \
    if [ -s /tmp/rclone.conf ]; then \
        mkdir -p /root/.config/rclone && \
        cp /tmp/rclone.conf /root/.config/rclone/rclone.conf && \
        chmod 0400 /root/.config/rclone/rclone.conf; \
    else \
        echo "[build] WARNING: no rclone_conf secret mounted; image will be unable to upload to Drive" >&2; \
    fi

# IMPORTANT: do NOT override the runpod/pytorch base image's ENTRYPOINT.
# Earlier we tried wrapping it via `exec /start.sh "$@"` but the base
# uses a different startup mechanism and our wrapper caused the
# container to exit immediately on boot (telemetry: "exited"). Verified
# 2026-05-10 with image tag :8.
#
# Instead, the laptop's submit_run.py SSHes in once after the pod is
# ready and execs /opt/startup_hook.sh inside a detached tmux session.
# That keeps the laptop's involvement bounded to a single SSH command
# at submission time — pod still self-drives the rest, and the
# container startup path is unchanged from the upstream base.
