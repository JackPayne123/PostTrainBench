# PTB base image for our fork.
#
# Mirrors PostTrainBench's harbor_adapter/template/environment/Dockerfile
# (the curated stack: vllm 0.11.0, claude-code, codex, gemini-cli, full ML
# package set, inspect_evals from GitHub) WITHOUT the per-task COPY layer.
# Per-task images derive from this via `FROM jackpayne123/ptb-base:1`.
#
# Pinned versions (vs PTB's template):
#   transformers>=4.46,<5.0   — vllm 0.11.0 calls Qwen2Tokenizer.all_special_tokens_extended
#                                 which transformers 5.x removed. Burned us 2026-05-07.
#
# Build (linux/amd64 from M-series Mac):
#   docker buildx build --platform linux/amd64 \
#     -f dockerfiles/Dockerfile.base \
#     -t jackpayne123/ptb-base:1 \
#     --push .
# Derive from RunPod's pytorch image — they ship a startup script that handles
# the $PUBLIC_KEY env var (writes authorized_keys, starts sshd) so the container
# stays alive and accepts SSH. nvcr.io/nvidia/cuda is bare and exits immediately
# (verified 2026-05-07: ptb-base:1 with bare cuda → container exited
# instantly).
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.local/bin:$PATH"
ENV NO_PROXY="localhost,127.0.0.1"
ENV no_proxy="localhost,127.0.0.1"

# System deps (rsync needed for our upload_dir/download_dir; git already in base)
# psmisc provides fuser/killall (port-based + name-based process kill).
# lsof provides another way to find PIDs holding files/ports.
# procps ensures pkill/pgrep/ps are present.
# iproute2 provides ss (port-based PID lookup) — usually present, listed for safety.
RUN apt-get update && apt-get install -y \
    rsync \
    ca-certificates \
    psmisc \
    lsof \
    procps \
    iproute2 \
    tmux \
    jq \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# rclone — fetch current stable directly from rclone's CDN. Ubuntu 22.04
# apt ships v1.58.1 (2022) which doesn't even search /etc/rclone.conf.
# The install.sh path (curl rclone.org/install.sh | bash) failed build
# :11 with curl exit 92 (HTTP/2 stream not closed cleanly) — rclone.org
# fronts on a flaky HTTP/2 endpoint. downloads.rclone.org is HTTP/1.1
# and serves binaries directly. --retry buys us against transient
# CDN blips during CI.
RUN curl --http1.1 -fsSL --retry 5 --retry-delay 3 \
        https://downloads.rclone.org/rclone-current-linux-amd64.zip \
        -o /tmp/rclone.zip && \
    unzip -q /tmp/rclone.zip -d /tmp/ && \
    install -m 0755 /tmp/rclone-*-linux-amd64/rclone /usr/bin/rclone && \
    rm -rf /tmp/rclone* && \
    rclone version

# Node.js 22 + npm (for claude-code, codex, gemini-cli)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs

# Note: PTB's original template uses `uv pip install --system`, but uv's resolver
# fails on vllm 0.11.0's xformers dep when run under QEMU emulation (arm64→amd64
# build on Apple Silicon). Plain pip handles it identically. Verified on a real
# RunPod x86_64 host 2026-05-07.

# vLLM 0.11.0 (must match transformers pin below)
RUN pip install --no-cache-dir vllm==0.11.0

# Coding agent CLIs
RUN npm install -g \
    @anthropic-ai/claude-code \
    @openai/codex \
    @google/gemini-cli

RUN pip install --no-cache-dir ninja packaging

# ML stack split in two to keep pip's resolver search space small.
# Use --use-deprecated=legacy-resolver throughout: pip's strict resolver
# backtracks aggressively on matplotlib/inspect-ai/etc and never converges
# under QEMU emulation in reasonable time. Legacy resolver matches first-fit
# (this is what uv/PTB-canonical install does on real x86_64 pods).
#
# Step A — training stack (HF ecosystem)
RUN pip install --no-cache-dir --use-deprecated=legacy-resolver \
    "transformers>=4.46,<5.0" \
    accelerate \
    datasets \
    evaluate \
    tokenizers \
    trl \
    peft

# Step B — eval / utility stack.
# huggingface-hub PINNED <1.0: inspect_evals depends on hf_hub 1.x but
# transformers 4.57.6 requires hf_hub<1.0,>=0.34.0. ptb-base:2 build let
# the conflict through (legacy-resolver warns, doesn't fail) and vllm
# crashed at runtime in import path. Pin keeps transformers callable.
RUN pip install --no-cache-dir --use-deprecated=legacy-resolver \
    "huggingface-hub>=0.34.0,<1.0" \
    anthropic \
    backoff \
    boto3 \
    bitsandbytes \
    hf_xet \
    hydra-core \
    "omegaconf>=2.4.0.dev2" \
    loguru \
    gdown \
    jsonlines \
    lm-eval \
    openai \
    pandas \
    scikit-learn \
    shortuuid \
    tiktoken \
    toml \
    "inspect-ai>=0.3.200" \
    "matplotlib>=3.7" \
    certifi

# inspect_evals (GitHub HEAD; matches PTB's pattern).
# --no-deps: prevents inspect_evals from upgrading huggingface_hub to 1.x
# (transformers 4.57 needs <1.0). Its actual transitive deps (backoff, hf_xet,
# toml) are installed explicitly in step B above. Verified end-to-end on debug
# pod 2026-05-07: vllm serves + responds to /v1/completions cleanly.
RUN mkdir -p /opt && \
    cd /opt && \
    git clone --depth=1 https://github.com/UKGovernmentBEIS/inspect_evals.git && \
    cd /opt/inspect_evals && \
    pip install --no-cache-dir --no-deps .

# Workspace dir for per-task COPY in derived images
RUN mkdir -p /home/agent/workspace
WORKDIR /home/agent/workspace

# ─── Self-driving pod harness (image-baked) ────────────────────────────────
#
# /opt/ptb/   = full src/ tree of this repo (so pod-side scripts can import
#               agent_run helpers + condition_prompts + adapter + etc.)
# /opt/startup_hook.sh = invoked by the pod's container entrypoint after SSH
#                        comes up; polls /workspace/runs/$RUN_ID/START and
#                        execs run_experiment.py inside tmux session "run".
# ~/.config/rclone/rclone.conf = OAuth-based remote named "drive" that targets the
#                        experiments folder. Full rclone.conf (including
#                        OAuth token JSON + root_folder_id) is baked into
#                        the image at build time from the RCLONE_CONF
#                        GitHub secret via BuildKit --mount=type=secret.
#                        SA-based auth was abandoned because service
#                        accounts have 0 Drive storage quota on personal
#                        Drives (storageQuotaExceeded on upload).
#
# To rebuild for a new src/ snapshot: bump tag, rerun
# `gh workflow run build-ptb-base.yml -f tag=N`.
#
# COPY of the repo root only includes paths that pod-side code needs at
# runtime — keep .dockerignore tight to avoid bloating the image with
# jobs/runs/, agent_workspace.tar.gz, etc.
COPY . /opt/ptb/
COPY pod/startup_hook.sh /opt/startup_hook.sh
RUN chmod +x /opt/startup_hook.sh

# OAuth-based rclone config for Drive uploads.
# Full rclone.conf (with refresh_token + root_folder_id) is mounted as a
# BuildKit secret named `rclone_conf` and written to rclone's default
# search path (/root/.config/rclone/rclone.conf). Tried /etc/rclone.conf
# first but rclone v1.58.1 (the version in our base image) does NOT
# search /etc — verified 2026-05-10 with diag_drive on :10. Diag tail:
#   Config file "/root/.config/rclone/rclone.conf" not found - using defaults
#   Failed to create file system for "drive:": didn't find section in config file
# Mount locally with:
#   docker buildx build --secret id=rclone_conf,src=$HOME/.config/ptb/rclone.conf ...
# In CI, the workflow passes secrets.RCLONE_CONF via build-push-action's
# `secret-files:` input. See dockerfiles/rclone.conf for expected structure.
RUN --mount=type=secret,id=rclone_conf,target=/tmp/rclone.conf \
    if [ -s /tmp/rclone.conf ]; then \
        mkdir -p /root/.config/rclone && \
        cp /tmp/rclone.conf /root/.config/rclone/rclone.conf && \
        chmod 0400 /root/.config/rclone/rclone.conf; \
    else \
        echo "[build] WARNING: no rclone_conf secret mounted; image will be unable to upload to Drive" >&2; \
    fi

# IMPORTANT: do NOT override the runpod/pytorch base image's ENTRYPOINT.
# Earlier we tried wrapping it via `exec /start.sh "$@"` but the base
# uses a different startup mechanism and our wrapper caused the
# container to exit immediately on boot (telemetry: "exited"). Verified
# 2026-05-10 with image tag :8.
#
# Instead, the laptop's submit_run.py SSHes in once after the pod is
# ready and execs /opt/startup_hook.sh inside a detached tmux session.
# That keeps the laptop's involvement bounded to a single SSH command
# at submission time — pod still self-drives the rest, and the
# container startup path is unchanged from the upstream base.
