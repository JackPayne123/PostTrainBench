# claude-trains-qwen-new — environment template
#
# Copy to `.env` and fill in your own values. `.env` is gitignored.
# Source it before running anything: `set -a && source .env && set +a`.
#
# Full first-time setup walkthrough: docs/OPERATIONS.md § Prerequisites,
# or the quick-reference in .claude/skills/running-experiments/SKILL.md § Environment.

# ─── RunPod (pod lifecycle + image pull) ─────────────────────────────────
# Generate at runpod.io/console/user/settings → API
RUNPOD_API_KEY=rpa_...

# Registry pull auth — required because the base image is private on GHCR.
# Workflow:
#   1. Create a GitHub PAT (classic) at github.com/settings/tokens with scope
#      `read:packages` only.
#   2. Register on RunPod via GraphQL once:
#        curl -sX POST https://api.runpod.io/graphql \
#          -H "Authorization: Bearer $RUNPOD_API_KEY" \
#          -H "Content-Type: application/json" \
#          -d '{"query":"mutation { saveRegistryAuth(input: {name: \"ghcr-ptb-base\", username: \"<your-gh-username>\", password: \"<github_pat>\"}) { id name } }"}'
#   3. Paste the returned `id` here.
RUNPOD_REGISTRY_AUTH_ID=cmp...

# Per-user network volume (multi-attach denied by the RunPod allocator —
# each concurrent pod needs its own). Create once with:
#   runpodctl network-volume create --name <user>-ptb --data-center-id EU-CZ-1 --size 100
# Leave unset to use the default `qwe92egpys` (jack-pilot-cz, Jack's volume —
# only works if you're Jack).
# RUNPOD_VOLUME_ID=

# ─── Anthropic / OpenAI / HuggingFace ────────────────────────────────────
# HF dataset access. The account whose token is here MUST have accepted terms
# at https://huggingface.co/datasets/Idavidrein/gpqa, else gpqamain fails in 9s
# with DatasetNotFoundError: gated.
HF_TOKEN=hf_...

# Used by inspect_evals' grader model (haiku via INSPECT_GRADER_MODEL) +
# contamination judge on some benches.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Used by the contamination judge (codex CLI) + healthbench/arenahardwriting
# graders.
OPENAI_API_KEY=sk-proj-...

# ─── Claude Code agent OAuth ──────────────────────────────────────────────
# The agent (`claude_non_api_max`) runs the `claude` CLI under OAuth — bills
# your Claude Max subscription, not API credits.
# Generate via: claude setup-token (browser flow). Token shape: sk-ant-oat01-...
# DO NOT SHARE across users — TOS violation + shared rate-limit budget.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
